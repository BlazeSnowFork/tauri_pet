# Git 换行符与文本属性配置
# 参考: https://git-scm.com/docs/gitattributes

# ---------------------------------------------------------------
# 换行符策略
# ---------------------------------------------------------------

# 默认：自动识别文本文件，仓库内统一存储为 LF，检出时也保持 LF
* text=auto eol=lf

# Windows 脚本必须使用 CRLF 才能正常运行
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.psm1 text eol=crlf

# Shell 脚本必须使用 LF（CRLF 会导致 /bin/bash^M 报错）
*.sh text eol=lf

# 明确声明为文本（防止个别环境下误判）
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.rs    text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.lock  text eol=lf

# ---------------------------------------------------------------
# 二进制文件（禁止换行符转换，防止文件损坏）
# ---------------------------------------------------------------

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.webp  binary

*.dll   binary
*.exe   binary
*.pdb   binary
*.lib   binary
*.so    binary
*.dylib binary
*.a     binary

*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

*.zip   binary
*.7z    binary
*.gz    binary
*.tar   binary
